{
  "name": "@calendry-de/calendry-proto",
  "version": "0.0.0-dev",
  "description": "TypeScript bindings for the Calendry solver gRPC contract — SolverInput/SolverOutput, the constraint catalogue, and the StartRun/GetStatus/CancelRun service.",
  "keywords": [
    "calendry",
    "protobuf",
    "grpc",
    "timetabling",
    "scheduling"
  ],
  "license": "UNLICENSED",
  "author": "Calendry-de",
  "homepage": "https://github.com/Calendry-de/calendry-proto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Calendry-de/calendry-proto.git",
    "directory": "packages/ts"
  },
  "bugs": {
    "url": "https://github.com/Calendry-de/calendry-proto/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "bash ./scripts/generate.sh",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist src/generated",
    "prepack": "npm run build"
  },
  "dependencies": {
    "protobufjs": "^7.4.0"
  },
  "peerDependencies": {
    "@grpc/grpc-js": "^1.12.0"
  },
  "peerDependenciesMeta": {
    "@grpc/grpc-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "ts-proto": "^2.6.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
